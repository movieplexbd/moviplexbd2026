<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  CineStream · Premium Warm Light Theme  (Material 3)   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <style name="Theme.OTTStreamingApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/surface2</item>
        <item name="colorTertiary">@color/gold</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/t1</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurfaceVariant">@color/t2</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="Theme.OTTStreamingApp.NoActionBar" parent="Theme.OTTStreamingApp" />

    <!-- Player (always dark regardless of system theme) -->
    <style name="Theme.OTTStreamingApp.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">#141414</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="Theme.OTTStreamingApp.Dark" parent="Theme.OTTStreamingApp.Player" />

    <!-- Splash -->
    <style name="Theme.OTTStreamingApp.Splash" parent="Theme.OTTStreamingApp">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Login -->
    <style name="Theme.OTTStreamingApp.Login" parent="Theme.OTTStreamingApp">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- ══  Typography  ══ -->
    <style name="TextStyle.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t1</item>
    </style>
    <style name="TextStyle.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t1</item>
    </style>
    <style name="TextStyle.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t1</item>
    </style>
    <style name="TextStyle.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/t2</item>
    </style>

    <!-- ══  Bottom Nav  ══ -->
    <style name="BottomNavTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BottomNavTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- Nav indicator pill -->
    <style name="NavIndicatorStyle">
        <item name="android:color">@color/nav_indicator</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>
    </style>
    <style name="NavIndicatorShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ══  Buttons  ══ -->
    <style name="Btn.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Btn.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
