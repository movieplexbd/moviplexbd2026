<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══ HERO BANNER ═══ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_banner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="16:9"
                    android:scaleType="centerCrop"
                    android:background="@color/surface2"
                    android:contentDescription="Movie poster" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/iv_banner"
                    app:layout_constraintBottom_toBottomOf="@id/iv_banner"
                    app:layout_constraintStart_toStartOf="@id/iv_banner"
                    app:layout_constraintEnd_toEndOf="@id/iv_banner"
                    android:background="@drawable/gradient_bottom_detail" />

                <!-- Back button -->
                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_margin="14dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="@drawable/bg_close_btn"
                    android:contentDescription="Back"
                    android:padding="10dp" />

                <!-- TRAILER button top-right -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_trailer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="14dp"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="▶ Trailer"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins"
                    app:backgroundTint="#CC000000"
                    app:cornerRadius="20dp"
                    android:visibility="gone" />

                <!-- FREE badge -->
                <TextView
                    android:id="@+id/tv_free_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/btn_trailer"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="14dp"
                    android:text="@string/free_badge"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_free"
                    android:visibility="gone" />

                <!-- Series badge -->
                <TextView
                    android:id="@+id/tv_series_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_back"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="8dp"
                    android:text="SERIES"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_premium_badge"
                    android:visibility="gone" />

                <!-- Title overlay -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@id/iv_banner"
                    app:layout_constraintStart_toStartOf="@id/iv_banner"
                    app:layout_constraintEnd_toEndOf="@id/iv_banner"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tv_title_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8" />
                </LinearLayout>

                <!-- Center play button (shown only for movies, hidden for series) -->
                <LinearLayout
                    android:id="@+id/layout_play_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@id/iv_banner"
                    app:layout_constraintBottom_toBottomOf="@id/iv_banner"
                    app:layout_constraintStart_toStartOf="@id/iv_banner"
                    app:layout_constraintEnd_toEndOf="@id/iv_banner"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btn_watch"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_play_circle"
                        android:background="@null"
                        android:scaleType="centerCrop"
                        android:contentDescription="Play" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ═══ CONTENT AREA ═══ -->
            <LinearLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Meta chips row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/amber"
                        android:fontFamily="@font/poppins"
                        android:background="@drawable/bg_rating"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/t2"
                        android:fontFamily="@font/poppins"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/t2"
                        android:fontFamily="@font/poppins"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/poppins"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <!-- Genre chips row -->
                <HorizontalScrollView
                    android:id="@+id/layout_genres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cg_genres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <!-- Download buttons -->
                <LinearLayout
                    android:id="@+id/layout_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="start" />

                <!-- Action buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/btn_watchlist_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_watchlist_star"
                            app:tint="@color/t2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ওয়াচলিস্ট"
                            android:textSize="10sp"
                            android:textColor="@color/t2"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_share_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_share"
                            app:tint="@color/t2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="শেয়ার"
                            android:textSize="10sp"
                            android:textColor="@color/t2"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_rate_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_star"
                            app:tint="@color/t2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="রেটিং"
                            android:textSize="10sp"
                            android:textColor="@color/t2"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Watch Party Button -->
                    <LinearLayout
                        android:id="@+id/btn_watch_party"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_play_circle"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Party"
                            android:textSize="10sp"
                            android:textColor="@color/brand_primary"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/border"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="14dp" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="@color/t2"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingMultiplier="1.6"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp" />

                <!-- ═══ CAST ═══ -->
                <LinearLayout
                    android:id="@+id/layout_actors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_cast_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="কাস্ট"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="10dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_actors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginBottom="20dp" />
                </LinearLayout>

                <!-- ═══ SERIES / EPISODES ═══ -->
                <LinearLayout
                    android:id="@+id/layout_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/border"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Season selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="এপিসোড"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/t1"
                            android:fontFamily="@font/poppins" />

                        <Spinner
                            android:id="@+id/spinner_season"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="100dp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_episodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />
                </LinearLayout>

                <!-- ═══ RELATED MOVIES ═══ -->
                <LinearLayout
                    android:id="@+id/layout_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/border"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="আরও দেখুন"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="10dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_related"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginBottom="16dp" />
                </LinearLayout>

                <!-- Locked panel -->
                <LinearLayout
                    android:id="@+id/layout_locked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/bg_locked_panel"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/brand_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="প্রিমিয়াম কন্টেন্ট"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="এই মুভিটি দেখতে সাবস্ক্রাইব করুন"
                        android:textSize="13sp"
                        android:textColor="@color/t2"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="16dp"
                        android:gravity="center" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_subscribe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="সাবস্ক্রাইব করুন"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins"
                        app:backgroundTint="@color/brand_primary"
                        app:cornerRadius="28dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="90dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading overlay -->
    <ProgressBar
        android:id="@+id/progress_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand_primary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
