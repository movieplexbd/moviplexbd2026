<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Thumbnail -->
    <androidx.cardview.widget.CardView
        android:layout_width="110dp"
        android:layout_height="68dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/iv_episode_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/surface2" />

        <!-- Lock overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#88000000">

            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lock"
                android:visibility="gone" />
        </LinearLayout>

        <!-- FREE badge -->
        <TextView
            android:id="@+id/tv_free_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:text="FREE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_free"
            android:visibility="gone" />

        <!-- Play button -->
        <ImageButton
            android:id="@+id/btn_play_episode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_circle"
            android:background="@null"
            android:padding="2dp"
            android:contentDescription="Play episode" />
    </androidx.cardview.widget.CardView>

    <!-- Episode info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_episode_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_episode_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/t1"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_episode_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textColor="@color/t3"
            android:fontFamily="@font/poppins"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_episode_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="@color/t3"
                android:fontFamily="@font/poppins" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_download_episode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="⬇"
                android:textSize="12sp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/red"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:paddingHorizontal="12dp"/>

            <TextView
                android:id="@+id/tv_episode_downloaded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Downloaded"
                android:textSize="10sp"
                android:textColor="@color/brand_primary"
                android:visibility="gone"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
