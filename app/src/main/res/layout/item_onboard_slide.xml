<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:paddingHorizontal="32dp" android:paddingBottom="120dp">

    <ImageView android:id="@+id/iv_onboard"
        android:layout_width="240dp" android:layout_height="240dp"
        android:scaleType="fitCenter" android:layout_marginBottom="40dp" />

    <TextView android:id="@+id/tv_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="24sp" android:textStyle="bold"
        android:textColor="@color/t1" android:fontFamily="@font/poppins"
        android:gravity="center" android:layout_marginBottom="14dp" />

    <TextView android:id="@+id/tv_description"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/t2"
        android:fontFamily="@font/poppins" android:gravity="center"
        android:lineSpacingMultiplier="1.6" />

</LinearLayout>
