<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background poster -->
    <ImageView
        android:id="@+id/iv_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/surface2"
        android:contentDescription="Banner"
        android:importantForAccessibility="yes" />

    <!-- Cinematic gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_banner" />

    <!-- Side gradient for depth -->
    <View
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/gradient_side_fade"
        android:alpha="0.5" />

    <!-- Bottom content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="28dp">

        <!-- Free badge -->
        <TextView
            android:id="@+id/tv_free_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="বিনামূল্যে"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.07"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_free"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:layout_marginBottom="6dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Meta info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <!-- Star rating chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_rating"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp">
                <TextView
                    android:id="@+id/tv_banner_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/amber"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <View android:layout_width="4dp" android:layout_height="4dp"
                android:background="@drawable/dot_mid" android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/tv_banner_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:fontFamily="@font/poppins" />

        </LinearLayout>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Play button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_banner_play"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="▶  দেখুন"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="28dp"
                android:paddingHorizontal="20dp"
                android:elevation="4dp"
                android:layout_marginEnd="10dp" />

            <!-- Info button -->
            <com.google.android.material.button.MaterialButton
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:text="ℹ"
                android:textSize="16sp"
                android:textColor="@color/white"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="28dp"
                app:strokeColor="#44FFFFFF"
                app:backgroundTint="#20FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
