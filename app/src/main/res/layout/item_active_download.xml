<?xml version="1.0" encoding="utf-8"?>
  <com.google.android.material.card.MaterialCardView
      xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginHorizontal="14dp" android:layout_marginBottom="10dp"
      app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp"
      app:cardElevation="0dp" app:strokeWidth="0.5dp" app:strokeColor="@color/border">

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="14dp">

          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
              <ImageView android:id="@+id/iv_thumb"
                  android:layout_width="60dp" android:layout_height="45dp"
                  android:scaleType="centerCrop" android:background="@color/surface2"
                  android:layout_marginEnd="10dp" />
              <TextView android:id="@+id/tv_title"
                  android:layout_width="0dp" android:layout_height="wrap_content"
                  android:layout_weight="1" android:textSize="13sp" android:textStyle="bold"
                  android:textColor="@color/t1" android:fontFamily="@font/poppins"
                  android:singleLine="true" android:ellipsize="end" />
              <ImageButton android:id="@+id/btn_cancel"
                  android:layout_width="36dp" android:layout_height="36dp"
                  android:src="@drawable/ic_close" android:background="?attr/selectableItemBackgroundBorderless"
                  android:padding="8dp" app:tint="@color/t3" android:contentDescription="Cancel" />
          </LinearLayout>

          <ProgressBar android:id="@+id/progress_bar"
              style="@android:style/Widget.ProgressBar.Horizontal"
              android:layout_width="match_parent" android:layout_height="6dp"
              android:progressTint="@color/brand_primary"
              android:progressBackgroundTint="@color/surface2"
              android:max="100" android:progress="0" />

          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:layout_marginTop="8dp">
              <TextView android:id="@+id/tv_percent"
                  android:layout_width="0dp" android:layout_height="wrap_content"
                  android:layout_weight="1" android:textSize="11sp"
                  android:textColor="@color/brand_primary" android:fontFamily="@font/poppins" />
              <TextView android:id="@+id/tv_file_size"
                  android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:textSize="11sp" android:textColor="@color/t3"
                  android:fontFamily="@font/poppins" />
              <TextView android:id="@+id/tv_speed"
                  android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:textSize="11sp" android:textColor="@color/t3"
                  android:fontFamily="@font/poppins" android:layout_marginStart="8dp" />
          </LinearLayout>

          <TextView android:id="@+id/tv_status"
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:textSize="11sp" android:textColor="@color/t3"
              android:fontFamily="@font/poppins" android:layout_marginTop="4dp" />
      </LinearLayout>
  </com.google.android.material.card.MaterialCardView>