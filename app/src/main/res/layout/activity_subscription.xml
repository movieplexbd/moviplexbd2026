<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:scrollbars="none" android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="40dp">

        <!-- Hero header (always dark/cinematic) -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="240dp"
            android:background="@drawable/bg_sub_header">

            <ImageButton android:id="@+id/btn_back"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="top|start" android:layout_margin="16dp"
                android:background="@drawable/bg_close_btn"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back" android:padding="10dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:orientation="vertical" android:padding="22dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔥 সীমিত অফার"
                    android:textColor="@color/brand_primary" android:textSize="11sp"
                    android:textStyle="bold" android:fontFamily="@font/poppins"
                    android:background="@drawable/bg_offer_badge"
                    android:paddingHorizontal="12dp" android:paddingVertical="5dp"
                    android:layout_marginBottom="10dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="এক্সক্লুসিভ প্ল্যান"
                    android:textColor="#FFFFFF" android:textSize="28sp"
                    android:textStyle="bold" android:fontFamily="@font/poppins"
                    android:layout_marginBottom="6dp" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="৳১০" android:textColor="#FFFFFF"
                        android:textSize="34sp" android:textStyle="bold"
                        android:fontFamily="@font/poppins" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" / এককালীন" android:textColor="#CCFFFFFF"
                        android:textSize="14sp" android:fontFamily="@font/poppins" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Feature list card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp"
            app:cardElevation="0dp" app:strokeWidth="0.5dp" app:strokeColor="@color/border">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="সুবিধাসমূহ" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/t1" android:fontFamily="@font/poppins"
                    android:layout_marginBottom="14dp" />

                <!-- Feature items -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle" app:tint="@color/green"
                        android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="সকল মুভি আনলিমিটেড দেখুন"
                        android:textSize="14sp" android:textColor="@color/t1"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle" app:tint="@color/green"
                        android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="HD কোয়ালিটিতে স্ট্রিমিং"
                        android:textSize="14sp" android:textColor="@color/t1"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle" app:tint="@color/green"
                        android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="অফলাইনে ডাউনলোড করুন"
                        android:textSize="14sp" android:textColor="@color/t1"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle" app:tint="@color/green"
                        android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="বিজ্ঞাপন-মুক্ত অভিজ্ঞতা"
                        android:textSize="14sp" android:textColor="@color/t1"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment ID input -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp"
            app:cardElevation="0dp" app:strokeWidth="0.5dp" app:strokeColor="@color/border">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="পেমেন্ট তথ্য দিন" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/t1"
                    android:fontFamily="@font/poppins" android:layout_marginBottom="14dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_trx_id"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="ট্রানজেকশন আইডি"
                    app:boxBackgroundColor="#06000000"
                    app:boxStrokeColor="@color/brand_primary"
                    app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                    app:hintTextColor="@color/t2"
                    app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_trx_id"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textColor="@color/t1"
                        android:fontFamily="@font/poppins" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="সাবমিট করুন" android:textSize="15sp"
                    android:textColor="@color/white" android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    app:backgroundTint="@null" android:background="@drawable/bg_login_button"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
