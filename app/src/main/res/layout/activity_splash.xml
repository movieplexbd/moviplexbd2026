<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Soft glow behind logo -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_login_blob"
        android:alpha="0.25" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo ring -->
        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center">

            <View android:layout_width="110dp" android:layout_height="110dp"
                android:background="@drawable/bg_play_circle" android:alpha="0.15" />

            <ImageView
                android:id="@+id/iv_splash_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/app_logo_new"
                android:scaleType="fitCenter"
                android:contentDescription="CineStream Logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/brand_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.03"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="মুভি স্ট্রিমিং"
            android:textColor="@color/t2"
            android:textSize="13sp"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.08"
            android:layout_marginTop="4dp" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_loading"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            app:lottie_rawRes="@raw/lottie_loading"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="v3.2.0"
        android:textColor="@color/t3"
        android:textSize="11sp"
        android:fontFamily="@font/poppins" />

</FrameLayout>
