<?xml version="1.0" encoding="utf-8"?>
  <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:background="@color/bg">

      <com.google.android.material.appbar.AppBarLayout
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:background="@color/surface" app:elevation="0dp">
          <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
              android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
              app:title="মুভি যোগ/সম্পাদনা"
              app:titleTextAppearance="@style/TextStyle.Title"
              app:navigationIcon="@drawable/ic_arrow_back"
              app:navigationIconTint="@color/t1" />
      </com.google.android.material.appbar.AppBarLayout>

      <ProgressBar android:id="@+id/progress_bar"
          android:layout_width="match_parent" android:layout_height="3dp"
          style="@android:style/Widget.ProgressBar.Horizontal"
          android:indeterminate="true"
          android:visibility="gone" />

      <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
          android:layout_weight="1" android:scrollbars="none" android:overScrollMode="never">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="vertical" android:padding="16dp">

              <!-- Thumbnail preview -->
              <com.google.android.material.card.MaterialCardView
                  android:layout_width="match_parent" android:layout_height="200dp"
                  android:layout_marginBottom="16dp"
                  app:cardBackgroundColor="@color/surface2" app:cardCornerRadius="16dp"
                  app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/border">
                  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                      <ImageView android:id="@+id/iv_preview"
                          android:layout_width="match_parent" android:layout_height="match_parent"
                          android:scaleType="centerCrop" />
                      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:layout_gravity="center" android:orientation="vertical"
                          android:gravity="center">
                          <ImageView android:layout_width="40dp" android:layout_height="40dp"
                              android:src="@drawable/ic_download" app:tint="@color/t3" />
                          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                              android:text="থাম্বনেইল URL দিন" android:textSize="12sp"
                              android:textColor="@color/t3" android:fontFamily="@font/poppins"
                              android:layout_marginTop="8dp" />
                      </LinearLayout>
                  </FrameLayout>
              </com.google.android.material.card.MaterialCardView>

              <!-- Fetch Metadata Button -->
              <com.google.android.material.button.MaterialButton android:id="@+id/btn_fetch_metadata"
                  android:layout_width="match_parent" android:layout_height="48dp"
                  android:text="TMDB থেকে তথ্য আনুন" android:textSize="14sp"
                  android:textColor="@color/t1" android:fontFamily="@font/poppins"
                  app:backgroundTint="@color/surface2" app:cornerRadius="12dp"
                  android:layout_marginBottom="16dp" />

              <!-- Title -->
              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/til_title"
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginBottom="12dp" android:hint="মুভির নাম *"
                  app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                  app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                  app:hintTextColor="@color/t2"
                  app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                  app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_title" android:layout_width="match_parent"
                      android:layout_height="wrap_content" android:textColor="@color/t1"
                      android:fontFamily="@font/poppins" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Description -->
              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/til_description"
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginBottom="12dp" android:hint="বিবরণ"
                  app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                  app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                  app:hintTextColor="@color/t2"
                  app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                  app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_description" android:layout_width="match_parent"
                      android:layout_height="wrap_content" android:inputType="textMultiLine"
                      android:lines="4" android:textColor="@color/t1" android:fontFamily="@font/poppins" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Banner Image URL -->
              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginBottom="12dp" android:hint="ব্যানার ছবি URL"
                  app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                  app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                  app:hintTextColor="@color/t2"
                  app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                  app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_banner_url" android:layout_width="match_parent"
                      android:layout_height="wrap_content" android:inputType="textUri"
                      android:textColor="@color/t1" android:fontFamily="@font/poppins" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Detail Thumbnail URL -->
              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginBottom="12dp" android:hint="ডিটেইল থাম্বনেইল URL"
                  app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                  app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                  app:hintTextColor="@color/t2"
                  app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                  app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_detail_thumbnail_url" android:layout_width="match_parent"
                      android:layout_height="wrap_content" android:inputType="textUri"
                      android:textColor="@color/t1" android:fontFamily="@font/poppins" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Video URL -->
              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/til_video_url"
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginBottom="12dp" android:hint="ভিডিও URL *"
                  app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                  app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                  app:hintTextColor="@color/t2"
                  app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                  app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_video_url" android:layout_width="match_parent"
                      android:layout_height="wrap_content" android:inputType="textUri"
                      android:textColor="@color/t1" android:fontFamily="@font/poppins" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Trailer URL -->
              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginBottom="12dp" android:hint="Trailer URL (YouTube/HLS)">
                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_trailer_url"
                      android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:inputType="textUri" android:fontFamily="@font/poppins" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Genre -->
              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_marginBottom="12dp" android:hint="Genre (comma separated: Action, Drama)">
                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/et_genre"
                      android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:inputType="text" android:fontFamily="@font/poppins" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Category Spinner -->
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:text="ক্যাটাগরি" android:textSize="12sp" android:textColor="@color/t2"
                  android:fontFamily="@font/poppins" android:layout_marginBottom="4dp" />
              <Spinner android:id="@+id/spinner_category"
                  android:layout_width="match_parent" android:layout_height="48dp"
                  android:background="@drawable/bg_card"
                  android:padding="8dp"
                  android:layout_marginBottom="12dp" />

              <!-- Rating, Year, Duration -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:orientation="horizontal" android:layout_marginBottom="12dp">
                  <com.google.android.material.textfield.TextInputLayout
                      android:id="@+id/til_rating"
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="1"
                      android:layout_height="wrap_content" android:hint="রেটিং"
                      android:layout_marginEnd="6dp"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_rating" android:layout_width="match_parent"
                          android:layout_height="wrap_content" android:inputType="numberDecimal"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="1"
                      android:layout_height="wrap_content" android:hint="বছর"
                      android:layout_marginEnd="6dp"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_year" android:layout_width="match_parent"
                          android:layout_height="wrap_content" android:inputType="number"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="1"
                      android:layout_height="wrap_content" android:hint="সময়"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_duration" android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
              </LinearLayout>

              <!-- Trending toggle -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                  android:orientation="horizontal" android:gravity="center_vertical"
                  android:background="@drawable/bg_card" android:paddingHorizontal="16dp"
                  android:layout_marginBottom="12dp">
                  <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                      android:layout_weight="1" android:text="ট্রেন্ডিং"
                      android:textSize="14sp" android:textColor="@color/t1"
                      android:fontFamily="@font/poppins" />
                  <com.google.android.material.switchmaterial.SwitchMaterial
                      android:id="@+id/switch_trending"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:checked="false" />
              </LinearLayout>

              <!-- Premium toggle -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                  android:orientation="horizontal" android:gravity="center_vertical"
                  android:background="@drawable/bg_card" android:paddingHorizontal="16dp"
                  android:layout_marginBottom="12dp">
                  <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                      android:layout_weight="1" android:text="প্রিমিয়াম কনটেন্ট"
                      android:textSize="14sp" android:textColor="@color/t1"
                      android:fontFamily="@font/poppins" />
                  <com.google.android.material.switchmaterial.SwitchMaterial
                      android:id="@+id/switch_free"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:checked="false" />
              </LinearLayout>

              <!-- Series toggle -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                  android:orientation="horizontal" android:gravity="center_vertical"
                  android:background="@drawable/bg_card" android:paddingHorizontal="16dp"
                  android:layout_marginBottom="12dp">
                  <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                      android:layout_weight="1" android:text="সিরিজ (Series)"
                      android:textSize="14sp" android:textColor="@color/t1"
                      android:fontFamily="@font/poppins" />
                  <com.google.android.material.switchmaterial.SwitchMaterial
                      android:id="@+id/switch_series"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:checked="false" />
              </LinearLayout>

              <!-- Actors Selection -->
              <com.google.android.material.button.MaterialButton android:id="@+id/btn_select_actors"
                  android:layout_width="match_parent" android:layout_height="48dp"
                  android:text="অভিনেতা নির্বাচন করুন" android:textSize="14sp"
                  android:textColor="@color/t1" android:fontFamily="@font/poppins"
                  app:backgroundTint="@color/surface2" app:cornerRadius="12dp"
                  android:layout_marginBottom="8dp" />

              <TextView android:id="@+id/tv_selected_actors"
                  android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:text="কোনো অভিনেতা সিলেক্ট করা নেই"
                  android:textSize="12sp" android:textColor="@color/t3"
                  android:fontFamily="@font/poppins"
                  android:layout_marginBottom="16dp" />

              <!-- Download Quality Section -->
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:text="ডাউনলোড লিংক" android:textSize="14sp" android:textStyle="bold"
                  android:textColor="@color/t1" android:fontFamily="@font/poppins"
                  android:layout_marginBottom="12dp" />

              <!-- 360p -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:orientation="horizontal" android:layout_marginBottom="8dp">
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="2"
                      android:layout_height="wrap_content" android:hint="360p URL"
                      android:layout_marginEnd="8dp"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_url_360" android:layout_width="match_parent"
                          android:layout_height="wrap_content" android:inputType="textUri"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="1"
                      android:layout_height="wrap_content" android:hint="সাইজ"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_size_360" android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
              </LinearLayout>

              <!-- 480p -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:orientation="horizontal" android:layout_marginBottom="8dp">
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="2"
                      android:layout_height="wrap_content" android:hint="480p URL"
                      android:layout_marginEnd="8dp"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_url_480" android:layout_width="match_parent"
                          android:layout_height="wrap_content" android:inputType="textUri"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="1"
                      android:layout_height="wrap_content" android:hint="সাইজ"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_size_480" android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
              </LinearLayout>

              <!-- 1080p -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:orientation="horizontal" android:layout_marginBottom="20dp">
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="2"
                      android:layout_height="wrap_content" android:hint="1080p URL"
                      android:layout_marginEnd="8dp"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_url_1080" android:layout_width="match_parent"
                          android:layout_height="wrap_content" android:inputType="textUri"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
                  <com.google.android.material.textfield.TextInputLayout
                      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                      android:layout_width="0dp" android:layout_weight="1"
                      android:layout_height="wrap_content" android:hint="সাইজ"
                      app:boxBackgroundColor="#06000000" app:boxStrokeColor="@color/brand_primary"
                      app:boxStrokeWidthFocused="1.5dp" app:boxStrokeWidth="0.5dp"
                      app:hintTextColor="@color/t2"
                      app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                      app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/et_size_1080" android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:textColor="@color/t1" android:fontFamily="@font/poppins" />
                  </com.google.android.material.textfield.TextInputLayout>
              </LinearLayout>

              <com.google.android.material.button.MaterialButton android:id="@+id/btn_save"
                  android:layout_width="match_parent" android:layout_height="54dp"
                  android:text="সংরক্ষণ করুন" android:textSize="15sp"
                  android:textColor="@color/white" android:textStyle="bold"
                  android:fontFamily="@font/poppins"
                  app:backgroundTint="@null" android:background="@drawable/bg_login_button"
                  app:cornerRadius="28dp" />

          </LinearLayout>
      </ScrollView>
  </LinearLayout>