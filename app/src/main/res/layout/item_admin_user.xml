<?xml version="1.0" encoding="utf-8"?>
  <com.google.android.material.card.MaterialCardView
      xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp"
      app:cardBackgroundColor="@color/surface" app:cardCornerRadius="16dp"
      app:cardElevation="0dp" app:strokeWidth="0.5dp" app:strokeColor="@color/border">

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="14dp">

          <!-- Header row -->
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
              <TextView android:id="@+id/tv_initial"
                  android:layout_width="44dp" android:layout_height="44dp"
                  android:gravity="center" android:textSize="16sp" android:textStyle="bold"
                  android:textColor="@color/white" android:fontFamily="@font/poppins"
                  android:background="@drawable/bg_avatar" android:layout_marginEnd="14dp" />
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                  android:layout_weight="1" android:orientation="vertical">
                  <TextView android:id="@+id/tv_name"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:textSize="14sp" android:textStyle="bold" android:textColor="@color/t1"
                      android:fontFamily="@font/poppins" />
                  <TextView android:id="@+id/tv_email"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:textSize="11sp" android:textColor="@color/t3"
                      android:fontFamily="@font/poppins" android:layout_marginTop="2dp" />
                  <TextView android:id="@+id/tv_expiry"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:textSize="10sp" android:textColor="@color/t3"
                      android:fontFamily="@font/poppins" android:layout_marginTop="2dp" />
              </LinearLayout>
              <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:orientation="vertical" android:gravity="center">
                  <TextView android:id="@+id/tv_plan"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:textSize="10sp" android:textStyle="bold" android:textColor="@color/white"
                      android:fontFamily="@font/poppins" android:background="@drawable/bg_premium_badge"
                      android:paddingHorizontal="9dp" android:paddingVertical="4dp"
                      android:layout_marginBottom="4dp" />
                  <TextView android:id="@+id/tv_status"
                      android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:textSize="9sp" android:textStyle="bold" android:textColor="@color/white"
                      android:fontFamily="@font/poppins" android:background="@drawable/bg_badge_free"
                      android:paddingHorizontal="7dp" android:paddingVertical="2dp" />
              </LinearLayout>
          </LinearLayout>

          <!-- Action buttons grid -->
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center">
              <com.google.android.material.button.MaterialButton android:id="@+id/btn_block"
                  android:layout_width="wrap_content" android:layout_height="36dp"
                  android:text="ব্লক" android:textSize="10sp"
                  android:textColor="@color/white" android:fontFamily="@font/poppins"
                  app:backgroundTint="@color/red" app:cornerRadius="8dp"
                  android:paddingHorizontal="8dp"
                  android:layout_marginEnd="6dp" />
              <com.google.android.material.button.MaterialButton android:id="@+id/btn_make_premium"
                  android:layout_width="wrap_content" android:layout_height="36dp"
                  android:text="প্রিমিয়াম দাও" android:textSize="10sp"
                  android:textColor="@color/white" android:fontFamily="@font/poppins"
                  app:backgroundTint="@color/amber" app:cornerRadius="8dp"
                  android:paddingHorizontal="8dp"
                  android:layout_marginEnd="6dp" />
              <ImageButton android:id="@+id/btn_extend"
                  android:layout_width="36dp" android:layout_height="36dp"
                  android:src="@drawable/ic_download" android:background="@drawable/bg_icon_btn"
                  android:padding="8dp" app:tint="@color/brand_primary"
                  android:contentDescription="Extend" android:layout_marginEnd="6dp" />
              <ImageButton android:id="@+id/btn_reset_password"
                  android:layout_width="36dp" android:layout_height="36dp"
                  android:src="@drawable/ic_info" android:background="@drawable/bg_icon_btn"
                  android:padding="8dp" app:tint="@color/t2"
                  android:contentDescription="Reset Password" android:layout_marginEnd="6dp" />
              <ImageButton android:id="@+id/btn_manage_devices"
                  android:layout_width="36dp" android:layout_height="36dp"
                  android:src="@drawable/ic_download" android:background="@drawable/bg_icon_btn"
                  android:padding="8dp" app:tint="@color/t2"
                  android:contentDescription="Manage Devices" android:layout_marginEnd="6dp" />
              <ImageButton android:id="@+id/btn_view_activity"
                  android:layout_width="36dp" android:layout_height="36dp"
                  android:src="@drawable/ic_info" android:background="@drawable/bg_icon_btn"
                  android:padding="8dp" app:tint="@color/t2"
                  android:contentDescription="View Activity" />
          </LinearLayout>
      </LinearLayout>
  </com.google.android.material.card.MaterialCardView>