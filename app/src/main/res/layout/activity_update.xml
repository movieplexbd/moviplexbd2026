<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:gravity="center" android:padding="32dp">

        <!-- Icon -->
        <FrameLayout android:layout_width="100dp" android:layout_height="100dp">
            <View android:layout_width="100dp" android:layout_height="100dp"
                android:background="@drawable/bg_play_circle" android:alpha="0.15" />
            <ImageView android:layout_width="60dp" android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download" app:tint="@color/brand_primary"
                android:contentDescription="Update" />
        </FrameLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="আপডেট পাওয়া গেছে!" android:textSize="22sp" android:textStyle="bold"
            android:textColor="@color/t1" android:fontFamily="@font/poppins"
            android:layout_marginTop="20dp" android:gravity="center" />

        <TextView android:id="@+id/tv_update_message"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/t2"
            android:fontFamily="@font/poppins" android:gravity="center"
            android:lineSpacingMultiplier="1.5" android:layout_marginTop="10dp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_update"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="এখনই আপডেট করুন" android:textSize="15sp"
            android:textColor="@color/white" android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:backgroundTint="@null" android:background="@drawable/bg_login_button"
            app:cornerRadius="28dp" />

        <TextView android:id="@+id/btn_skip"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="পরে করব" android:textSize="13sp"
            android:textColor="@color/t3" android:fontFamily="@font/poppins"
            android:layout_marginTop="16dp" android:padding="8dp"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
