<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center"
    android:layout_marginHorizontal="6dp" android:padding="4dp"
    android:clickable="true" android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_actor"
        android:layout_width="58dp" android:layout_height="58dp"
        android:src="@drawable/ic_nav_profile"
        app:civ_border_width="1.5dp" app:civ_border_color="@color/border" />

    <TextView android:id="@+id/tv_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="@color/t2"
        android:fontFamily="@font/poppins" android:gravity="center"
        android:maxLines="2" android:ellipsize="end"
        android:layout_marginTop="6dp" />

</LinearLayout>
