<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/surface"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp" android:background="@drawable/bg_handle" />

    <!-- Header row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingBottom="14dp">

        <ImageView android:id="@+id/iv_thumb"
            android:layout_width="70dp" android:layout_height="100dp"
            android:scaleType="centerCrop" android:background="@drawable/bg_movie_card"
            android:layout_marginEnd="14dp" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/tv_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/t1" android:fontFamily="@font/poppins"
                android:maxLines="2" android:ellipsize="end" />

            <TextView android:id="@+id/tv_rating"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/amber"
                android:fontFamily="@font/poppins" android:layout_marginTop="5dp" />

            <TextView android:id="@+id/tv_category"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/t3"
                android:fontFamily="@font/poppins" android:layout_marginTop="3dp" />

        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="@color/border" android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Action buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_watch"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="▶  এখনই দেখুন" android:textSize="15sp"
            android:textColor="@color/white" android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:backgroundTint="@null" android:background="@drawable/bg_login_button"
            app:cornerRadius="14dp" android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_download"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="ডাউনলোড করুন" android:textSize="14sp"
            android:textColor="@color/brand_primary" android:fontFamily="@font/poppins"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/brand_primary" app:strokeWidth="1dp"
            app:cornerRadius="14dp" app:backgroundTint="@color/transparent"
            android:layout_marginBottom="10dp"
            app:icon="@drawable/ic_download" app:iconTint="@color/brand_primary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_watchlist"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
                android:text="ওয়াচলিস্ট" android:textSize="13sp"
                android:textColor="@color/t1" android:fontFamily="@font/poppins"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/border" app:cornerRadius="14dp"
                app:backgroundTint="@color/transparent"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_share"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
                android:text="শেয়ার" android:textSize="13sp"
                android:textColor="@color/t1" android:fontFamily="@font/poppins"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/border" app:cornerRadius="14dp"
                app:backgroundTint="@color/transparent" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
